# Copie para .env.local e preencha. Local = ambiente de TESTES (nunca credenciais de produção).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (projeto de testes: ookosqyfazobiwmopiix)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App do Mercado Livre (de teste: client id 8693830632560554)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://mlresponde-v2.vercel.app/api/auth/callback/mercadolivre

# 32 bytes em base64 (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Precisa ser a MESMA do ambiente que gravou os tokens no banco.
ML_TOKEN_ENCRYPTION_KEY=

# Motor de respostas (v1, até o sub-projeto 2)
OPENAI_API_KEY=
