# Copie para .env.local e preencha. ATENÇÃO: desde a Sessão 15 só existe um Supabase da v2 e ele é PRODUÇÃO
# (dados reais). O que rodar localmente mexe nesse banco.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase da v2 (ookosqyfazobiwmopiix). Chaves no formato novo: publishable (sb_publishable_...) e secret (sb_secret_...).
# As chaves antigas (JWT anon/service_role) estão desligadas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App do Mercado Livre da v2 (client id 8693830632560554; definitivo, vai se chamar maanu)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://maanu.com.br/api/auth/callback/mercadolivre

# 32 bytes em base64 (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Precisa ser a MESMA do ambiente que gravou os tokens no banco.
ML_TOKEN_ENCRYPTION_KEY=

# IA (motor de respostas). A chave "em uso" cadastrada no painel do administrador (Chaves de IA) tem prioridade;
# esta variável é o último recurso (sem chave no painel ou sem conseguir abrir a do painel).
OPENAI_API_KEY=
# Chave-mestra que tranca as chaves de IA cadastradas no painel (32 bytes em base64, gerar como a de baixo).
# Precisa ser a MESMA em todo servidor que usa o mesmo banco. Perdeu? Gere outra e cadastre as chaves de novo no painel.
AI_KEYS_ENCRYPTION_KEY=
# Opcional; padrão gpt-6-luna (para voltar ao antigo sem mexer no código: gpt-4o-mini)
OPENAI_MODEL=

# Protege /api/cron/questions (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Opcional: endereço próprio do painel do administrador (ex.: admin.maanu.com.br). Com ele definido, /admin só abre
# nesse endereço (no domínio do app vira 404). Sem ele, o painel fica em /admin. Ver CEREBRO.md.
ADMIN_HOST=

# Opcional: endereço próprio do app (ex.: app.maanu.com.br). Sem ele, maanu.com.br/ é a página de vendas e o app segue
# no mesmo endereço. Com ele, o domínio principal fica só com a página de vendas (+ termos, privacidade e webhooks) e o
# resto vai para o mesmo caminho neste endereço. Junto, trocar NEXT_PUBLIC_SITE_URL e ML_REDIRECT_URI (CEREBRO.md §13).
APP_HOST=

# Opcional: verificação do Google Search Console (meta tag) e do Bing Webmaster Tools (msvalidate.01). Só o código do
# content. Desnecessárias se o domínio for verificado pelo DNS (Google) e importado do Search Console (Bing).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
